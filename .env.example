# Local development uses yt-dlp. Set MEDIA_MODE=server for a Vercel deployment.
MEDIA_MODE=local
YOUTUBE_DOWNLOADER=cobalt
COBALT_API_URL=https://YOUR-COBALT-INSTANCE/

# Hosted URL for your backend server (e.g. on Render, Railway, VPS, or Vercel).
# The browser extension automatically reads this to connect to your hosted server:
NEXT_PUBLIC_APP_URL=https://your-localdrop-server.com
